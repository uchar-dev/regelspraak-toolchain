              "JUTTER.AANTAL_WAARDEVOL",
              "JUTTER:PREMIE_WAARDIG"
            ]
          }
        },
        "parameters": [
          {
            "name": "vocabulaire",
            "in": "query",
            "required": false,
            "description": "Het vocabulaire waarin het antwoord de declaraties noemt; zonder: 'cgm', de standaard van dit entrypoint. Een declaratie zonder benaming in het gekozen vocabulaire draagt haar canonieke naam; GET /info noemt die declaraties per vocabulaire. Een onbekend vocabulaire is een 400 (ONBEKEND_VOCABULAIRE).",
            "schema": {
