{
  "openapi": "3.0.3",
  "info": {
    "title": "Jutterswet vocabulaires",
    "version": "tweeling",
    "description": "De namen in dit document zijn de canonieke namen. De dienst neemt in een verzoek elke naam aan: canoniek of als benaming in de vocabulaires 'handboek' en 'cgm', ook gemengd; x-spellingen en x-waardespellingen noemen ze. Een naam die zo twee declaraties noemt is een 400 (DUBBELZINNIGE_NAAM), tenzij de queryparameter invoervocabulaire het vocabulaire vastzet; de queryparameter vocabulaire kiest de namen van het antwoord. Een gewijzigde benaming is een wijziging van dit contract.",
    "x-vocabulaire": "canoniek"
  },
  "paths": {
    "/premie": {
      "post": {
        "operationId": "premie",
        "summary": "premie",
        "description": "Entrypoint 'premie'. Invoer-objecttypen: Jutter, Vondst. Uitvoer-selectoren: Vondst.soort, Vondst.premie, Vondst:waardevol, Jutter.vondstbedrag, Jutter.aantal waardevolle vondsten, Jutter:premiewaardig. De dienst neemt ook de spellingen van x-spellingen aan.",
        "x-spellingen": {
          "handboek": {
            "invoer": [
              "strandjutter",
              "aangespoeld voorwerp"
            ],
            "uitvoer": [
              "aangespoeld voorwerp.soort vondst",
              "aangespoeld voorwerp.premie voor de vondst",
              "aangespoeld voorwerp:van waarde",
              "strandjutter.totale premie",
              "strandjutter.aantal vondsten van waarde",
              "strandjutter:komt in aanmerking voor premie"
            ]
          },
          "cgm": {
            "invoer": [
              "JUTTER",
              "VONDST"
            ],
            "uitvoer": [
              "VONDST.VONDST_SOORT",
              "VONDST.PREMIE",
              "VONDST:WAARDEVOL",
              "JUTTER.VONDST_BEDRAG",
              "JUTTER.AANTAL_WAARDEVOL",
              "JUTTER:PREMIE_WAARDIG"
            ]
          }
        },
        "parameters": [
          {
            "name": "vocabulaire",
            "in": "query",
            "required": false,
            "description": "Het vocabulaire waarin het antwoord de declaraties noemt; zonder: de canonieke namen. Een declaratie zonder benaming in het gekozen vocabulaire draagt haar canonieke naam; GET /info noemt die declaraties per vocabulaire. Een onbekend vocabulaire is een 400 (ONBEKEND_VOCABULAIRE).",
            "schema": {
              "type": "string",
              "enum": [
                "canoniek",
                "handboek",
                "cgm"
              ]
            }
          },
          {
            "name": "invoervocabulaire",
            "in": "query",
            "required": false,
            "description": "Zet het vocabulaire vast waarin de namen van het verzoek gelezen worden; zonder wordt elke naam gelezen als canonieke naam of als benaming in elk vocabulaire.",
            "schema": {
              "type": "string",
              "enum": [
                "canoniek",
                "handboek",
                "cgm"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Verzoek"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "beslissing berekend",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Antwoord"
                }
              }
            }
          },
          "400": {
            "description": "verzoek valideert niet — het antwoord noemt het foutieve veld",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fout"
                }
              }
            }
          },
          "404": {
            "description": "onbekend pad",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fout"
                }
              }
            }
          },
          "422": {
            "description": "de regels geven op deze invoer een evaluatiefout: status EVALUATIEFOUT, per fout de soort en uchars zin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Evaluatiefout"
                }
              }
            }
          },
          "503": {
            "description": "uchar draagt dit entrypoint niet: status MARKER, met uchars reden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fout"
                }
              }
            }
          },
          "500": {
            "description": "interne fout (geen stacktrace gelekt)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fout"
                }
              }
            }
          }
        }
      }
    },
    "/premie-cgm": {
      "post": {
        "operationId": "premieInHetCgm",
        "summary": "premie in het cgm",
        "description": "Entrypoint 'premie in het cgm'. Invoer-objecttypen: Jutter, Vondst. Uitvoer-selectoren: Vondst.soort, Vondst.premie, Vondst:waardevol, Jutter.vondstbedrag, Jutter.aantal waardevolle vondsten, Jutter:premiewaardig. De dienst neemt ook de spellingen van x-spellingen aan.",
        "x-spellingen": {
          "handboek": {
            "invoer": [
              "strandjutter",
              "aangespoeld voorwerp"
            ],
            "uitvoer": [
              "aangespoeld voorwerp.soort vondst",
              "aangespoeld voorwerp.premie voor de vondst",
              "aangespoeld voorwerp:van waarde",
              "strandjutter.totale premie",
              "strandjutter.aantal vondsten van waarde",
              "strandjutter:komt in aanmerking voor premie"
            ]
          },
          "cgm": {
            "invoer": [
