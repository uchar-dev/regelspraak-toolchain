            "required": false,
            "description": "Zet het vocabulaire vast waarin de namen van het verzoek gelezen worden; zonder wordt elke naam gelezen als canonieke naam of als benaming in elk vocabulaire.",
            "schema": {
              "type": "string",
              "enum": [
                "canoniek",
                "handboek",
                "cgm"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Verzoek"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "beslissing berekend",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Antwoord"
                }
              }
            }
          },
          "400": {
            "description": "verzoek valideert niet — het antwoord noemt het foutieve veld",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fout"
                }
              }
            }
          },
          "404": {
            "description": "onbekend pad",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fout"
                }
              }
            }
          },
          "422": {
            "description": "de regels geven op deze invoer een evaluatiefout: status EVALUATIEFOUT, per fout de soort en uchars zin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Evaluatiefout"
                }
              }
            }
          },
          "503": {
            "description": "uchar draagt dit entrypoint niet: status MARKER, met uchars reden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fout"
                }
              }
            }
          },
          "500": {
            "description": "interne fout (geen stacktrace gelekt)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fout"
                }
              }
            }
          }
        }
      }
    },
    "/info": {
      "get": {
        "operationId": "info",
        "summary": "dienst-info",
        "description": "De dienst-identiteit, de per-regel Dekking-verdicten, de overgeslagen (marker) regels en de parameter-defaults.",
        "responses": {
          "200": {
            "description": "dienst-info",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Info"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Jutter": {
        "type": "object",
        "properties": {
          "naam": {
            "type": "string",
            "description": "De dienst neemt ook 'naam' (handboek) en 'NAAM' (cgm) aan.",
            "x-spellingen": {
              "handboek": "naam",
              "cgm": "NAAM"
            }
          },
          "vondstbedrag": {
            "type": "number",
            "description": "De dienst neemt ook 'totale premie' (handboek) en 'VONDST_BEDRAG' (cgm) aan.",
            "x-spellingen": {
              "handboek": "totale premie",
              "cgm": "VONDST_BEDRAG"
            }
          },
          "aantal waardevolle vondsten": {
            "type": "integer",
            "description": "De dienst neemt ook 'aantal vondsten van waarde' (handboek) en 'AANTAL_WAARDEVOL' (cgm) aan.",
            "x-spellingen": {
              "handboek": "aantal vondsten van waarde",
              "cgm": "AANTAL_WAARDEVOL"
            }
          },
          "premiewaardig": {
            "type": "boolean",
            "description": "kenmerk. De dienst neemt ook 'komt in aanmerking voor premie' (handboek) en 'PREMIE_WAARDIG' (cgm) aan.",
            "x-spellingen": {
              "handboek": "komt in aanmerking voor premie",
              "cgm": "PREMIE_WAARDIG"
            }
          }
        },
        "description": "Objecttype 'Jutter'. Kenmerken (boolean-eigenschappen): premiewaardig. De dienst neemt ook 'strandjutter' (handboek) en 'JUTTER' (cgm) aan.",
        "x-spellingen": {
          "handboek": "strandjutter",
          "cgm": "JUTTER"
        }
      },
      "Vondst": {
        "type": "object",
        "properties": {
          "soort": {
            "type": "string",
            "enum": [
              "wrakhout",
              "barnsteen",
              "flessenpost"
            ],
            "x-waardespellingen": {
              "wrakhout": {
                "handboek": "hout van een wrak",
                "cgm": "WRAKHOUT"
              },
              "barnsteen": {
                "handboek": "amber",
                "cgm": "BARNSTEEN"
              },
              "flessenpost": {
                "handboek": "bericht in een fles",
                "cgm": "FLESSENPOST"
              }
            },
            "description": "De dienst neemt ook 'soort vondst' (handboek) en 'VONDST_SOORT' (cgm) aan.",
            "x-spellingen": {
              "handboek": "soort vondst",
              "cgm": "VONDST_SOORT"
            }
          },
          "gewicht": {
            "type": "number",
            "description": "De dienst neemt ook 'gewicht in kilogram' (handboek) en 'GEWICHT' (cgm) aan.",
            "x-spellingen": {
              "handboek": "gewicht in kilogram",
              "cgm": "GEWICHT"
            }
          },
          "premie": {
            "type": "number",
            "description": "De dienst neemt ook 'premie voor de vondst' (handboek) en 'PREMIE' (cgm) aan.",
            "x-spellingen": {
              "handboek": "premie voor de vondst",
              "cgm": "PREMIE"
            }
          },
          "waardevol": {
            "type": "boolean",
            "description": "kenmerk. De dienst neemt ook 'van waarde' (handboek) en 'WAARDEVOL' (cgm) aan.",
            "x-spellingen": {
              "handboek": "van waarde",
              "cgm": "WAARDEVOL"
            }
          }
        },
        "description": "Objecttype 'Vondst'. Kenmerken (boolean-eigenschappen): waardevol. De dienst neemt ook 'aangespoeld voorwerp' (handboek) en 'VONDST' (cgm) aan.",
        "x-spellingen": {
          "handboek": "aangespoeld voorwerp",
          "cgm": "VONDST"
        }
      },
      "Verzoek": {
        "type": "object",
        "description": "Een beslissingsverzoek: gelabelde object-instanties met attribuut-/kenmerk-waarden en rol-relaties, plus optionele parameter-overrides en rekendatum.",
        "required": [
          "instanties"
        ],
        "properties": {
          "peildatum": {
            "type": "string",
            "format": "date",
            "description": "ISO-datum (yyyy-MM-dd); optioneel. De ÉÉN datumautoriteit: dezelfde datum selecteert de parameterset-vintage EN is de rekendatum-global. Gelijk aan 'rekendatum' (alias); beide meegeven met verschillende waarden is een 400."
          },
          "rekendatum": {
            "type": "string",
            "format": "date",
            "description": "ISO-datum (yyyy-MM-dd); optioneel. Alias van 'peildatum' (dezelfde datumautoriteit)."
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true,
            "description": "parameternaam -> waarde; overschrijft de descriptor-defaults."
          },
          "instanties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "id"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "attributen": {
                  "type": "object",
                  "additionalProperties": true,
                  "description": "attribuutnaam -> waarde (per het objecttype-schema)."
                },
                "kenmerken": {
                  "type": "object",
                  "additionalProperties": true,
                  "description": "kenmerknaam -> boolean."
                },
                "rollen": {
                  "type": "object",
                  "additionalProperties": true,
                  "description": "rolnaam -> doel-id of lijst van doel-ids."
                }
              }
            }
          },
          "relaties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "feittype",
                "rollen"
              ],
              "properties": {
                "feittype": {
                  "type": "string"
                },
                "rollen": {
                  "type": "object",
                  "additionalProperties": true,
                  "description": "rolnaam -> id of lijst van ids."
                }
              }
            }
          }
        }
      },
      "Antwoord": {
        "type": "object",
        "description": "Het beslissingsantwoord: per instantie de gevraagde uitvoer-attributen/-kenmerken, plus de namen van de regels waarvan een consistentietoets faalde.",
        "properties": {
          "instanties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "attributen": {
                  "type": "object",
                  "additionalProperties": true,
                  "description": "attribuutnaam -> waarde (of null bij leeg)."
                },
                "kenmerken": {
                  "type": "object",
                  "additionalProperties": true,
                  "description": "kenmerknaam -> boolean."
                }
              }
            }
          },
          "inconsistenties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "de namen van de regels waarvan een consistentietoets INCONSISTENT opleverde."
          },
          "inconsistentieDetails": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "regel": {
                  "type": "string"
                },
                "onderwerp": {
                  "type": "string",
                  "nullable": true
                }
              }
            },
            "description": "dezelfde inconsistenties met hun onderwerp: het id van de instantie waarover de toets ging, of null als dat geen instantie van het verzoek is."
          }
        }
      },
      "Fout": {
        "type": "object",
        "description": "Een dienst-fout; noemt waar mogelijk het foutieve veld/pad.",
        "required": [
          "fout"
        ],
        "properties": {
          "fout": {
            "type": "string"
          },
          "veld": {
            "type": "string"
          },
          "schendingen": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "de verzameling schendingen, elk met soort/veld/melding."
          }
        }
      },
      "Evaluatiefout": {
        "type": "object",
        "description": "De regels geven op deze invoer geen antwoord: aan het fixpunt staan een of meer evaluatiefouten, elk met haar soort en uchars zin.",
        "required": [
          "status",
          "fout",
          "fouten"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "EVALUATIEFOUT"
            ]
          },
          "fout": {
            "type": "string",
            "description": "zegt dat de regels op deze invoer een evaluatiefout geven, of hoeveel."
          },
          "fouten": {
            "type": "array",
            "description": "een element per fout, in uchars volgorde.",
            "items": {
              "type": "object",
              "required": [
                "soort",
                "fout"
              ],
              "properties": {
                "soort": {
                  "type": "string",
                  "enum": [
                    "DELING_DOOR_NUL",
                    "REKENFOUT",
                    "SCHRIJVERSCONFLICT",
                    "INVOERVORMFOUT",
                    "ANDERE"
                  ],
                  "description": "DELING_DOOR_NUL: een deling door een numerieke nul; REKENFOUT: een fout van een berekening of van de rekendatum; SCHRIJVERSCONFLICT: twee schrijvers van één attribuut die verschillen; INVOERVORMFOUT: een tijdlijninvoer in de andere conventie, die geen verzoek bereikt, want de dienst weigert een tijdlijn (400); ANDERE: een fout van een ander type die aan het fixpunt staat, zoals een feitcreatie die een naar-één-rol een tweede vulling geeft."
                },
                "fout": {
                  "type": "string",
                  "description": "uchars zin; een object van het verzoek heet daarin naar zijn id."
                }
              }
            }
          }
        }
      },
      "Info": {
        "type": "object",
        "description": "De dienst-info: identiteit, per-regel Dekking, overgeslagen markers, parameters.",
        "properties": {
          "dienst": {
            "type": "object"
          },
          "dekking": {
            "type": "object"
          },
          "overgeslagen": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parameters": {
            "type": "object"
          },
          "parametersets": {
            "type": "array"
          },
          "periodeWaarschuwingen": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "vocabulaires": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "per vocabulaire: naam, standaard, taal, of het volledig is, en de declaraties zonder benaming (die draagt een antwoord in dat vocabulaire bij hun canonieke naam)."
          }
        }
      }
    }
  }
}
