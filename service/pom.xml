<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.uchar.regelspraak.toolchain</groupId>
    <artifactId>regelspraak-toolchain</artifactId>
    <version>0-SNAPSHOT</version>
  </parent>

  <artifactId>service</artifactId>
  <name>RegelSpraak decision service (HTTP + OpenAPI)</name>

  <!--
    The decision-service core: descriptor-driven HTTP delivery of the engine. Framework-agnostic (descriptor
    model, request->facts mapping, session-per-request execution, response building) with the JDK's
    com.sun.net.httpserver as the only HTTP layer; the Quarkus adapter reuses the core unchanged.
  -->

  <properties>
    <skippin.poort>service</skippin.poort>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.uchar.regelspraak.toolchain</groupId>
      <artifactId>toolchain</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- A test-jar beside the main jar, so the Quarkus adapter can reuse the golden-parity harness (TokaBron,
           SituatieNaarVerzoek, the manifest reader) without re-typing an expected value. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-jar</id>
            <goals><goal>test-jar</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- One KieBase per entry point times several test classes: each test class runs in a fresh JVM so
               one class's Drools builds cannot leave state for the next, with a heap of its own (MAVEN_OPTS does
               not reach the fork). -->
          <forkCount>1</forkCount>
          <reuseForks>false</reuseForks>
          <argLine>-Xmx1536m</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
