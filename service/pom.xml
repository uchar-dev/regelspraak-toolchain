<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.uchar.regelspraak.toolchain</groupId>
    <artifactId>regelspraak-toolchain</artifactId>
    <version>0-SNAPSHOT</version>
  </parent>

  <artifactId>service</artifactId>
  <name>RegelSpraak decision service (HTTP + OpenAPI)</name>

  <!--
    The decision-service core: descriptor-driven HTTP delivery of the engine. Framework-agnostic (descriptor
    model, request->facts mapping, session-per-request execution, response building) with the JDK's
    com.sun.net.httpserver as the only HTTP layer; the Quarkus adapter reuses the core unchanged.
  -->

  <properties>
    <skippin.gate>service</skippin.gate>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.uchar.regelspraak.toolchain</groupId>
      <artifactId>toolchain</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- Drools logs through SLF4J and brings no backend, so every command printed SLF4J's StaticLoggerBinder
         notice. A backend at WARN (simplelogger.properties) keeps Drools' warnings and errors on stderr, where a
         no-op backend would drop them. Optional: the Quarkus adapter depends on this module and logs through
         Quarkus. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- A test-jar beside the main jar, so the Quarkus adapter can reuse the golden-parity harness (TokaSource,
           the manifest reader) without re-typing an expected value; SituationToRequest is in the main jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-jar</id>
            <goals><goal>test-jar</goal></goals>
          </execution>
        </executions>
      </plugin>
      <!-- The distribution's one runtime artifact: this module with everything it runs on (the CLI, the scenario
           runner, uchar's frontend and backend, Drools, Jackson, ANTLR) in target/regelspraak.jar. bin/regelspraak
           and the container run from it. With outputFile set the module's own jar stays the main artifact, so the
           Quarkus adapter still depends on the plain jar. No dependency-reduced POM: the plugin would write one
           beside this pom anyway and make it the module's POM, without the dependencies the adapter builds on. The
           service files are merged, because two Drools jars register the same service interface; signatures, the
           jar index and module descriptors are left out, as they describe the separate jars and not the merged
           one. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <id>regelspraak-jar</id>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <outputFile>${project.build.directory}/regelspraak.jar</outputFile>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/INDEX.LIST</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- One KieBase per entry point times several test classes: each test class runs in a fresh JVM so
               one class's Drools builds cannot leave state for the next, with a heap of its own (MAVEN_OPTS does
               not reach the fork). -->
          <forkCount>1</forkCount>
          <reuseForks>false</reuseForks>
          <argLine>-Xmx1536m</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
