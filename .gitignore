# ANTLR tool jar — re-fetch with `make antlr-jar`
lib/

# ANTLR-generated sources and compiled classes
gen/
out/
*.class
*.tokens
*.interp

# Maven (added later, when the JVM app code lands)
target/

# Spec-conversion scratch (regenerable from the PDFs)
specification/*/_work/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Personal, uncommitted Claude Code overrides
.claude/settings.local.json

# Regenerable spec-example extractions (use tools/extract_corpus.py)
examples/spec-main/
examples/spec-antlr/
backlog/

# VM IP for docs deploy — both resolver locations (regenerate: dig +short <docs-host> > .vm-ip)
/.vm-ip
/deployment/.vm-ip
