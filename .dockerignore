# Keep the build context lean: the service image only needs what stage 1/2 build
# from (Makefile, poms, vendor/tools/src, engine/service, examples, docker/). The
# ANTLR jar is re-fetched by `make parser` inside the build, so lib/ is excluded;
# every generated/build tree is excluded so a dirty host checkout cannot leak in.
.git
lib/
gen/
out/
target/
engine/target/
service/target/
alef-comparison/
scratch_candC_75318/
specification/
backlog/
docs/
*.md
.claude/
.idea/
.DS_Store
