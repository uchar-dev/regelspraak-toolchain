#!/usr/bin/env bash
# bin/regelspraak — the entry of the RegelSpraak toolchain: one command per task, no class name and no build path.
#
# Every command runs from the one jar the reactor builds (the service module shades it). In a checkout this script
# rebuilds that jar first when it is missing or older than a source it is built from, with Maven offline and without
# tests, so a changed source or a moved uchar pin is never run stale. REGELSPRAAK_JAR names a prebuilt jar instead
# (the container sets it) and is never rebuilt. JAVA_OPTS reach the JVM; JAVA_HOME picks the JDK.
set -euo pipefail

usage() {
  cat <<'TEXT'
usage: bin/regelspraak [--language nl|en] <command> [arguments]

  --language   the language of uchar's messages (nl by default)

  check <source.rgs...>                 parse and resolve; the diagnostics, then whether uchar carries the model
  ir <out.json> <source.rgs...>         the uchar-ir-v1 document of the model (uchar's emitter)
  cases <dir> <source.rgs...>           the scenarios lowered to case files in <dir>, beside <dir>/ir.json
  tokens <out.json> <source.rgs...>     the semantic tokens of the sources (uchar's Resolver.tokens): per file the
                                        spans with kind and position, and the diagnostics; written also when the
                                        model has an error or a syntax error, then exit 0
  scenario [--trace] [--explanation] [--vocabulary <name>] <source.rgs...>
  scenario [--trace] --manifest <manifest> [--exclusions <list>]
                                        lowering, uchar's replay and the report: PASS, FAIL or MARKER per scenario;
                                        --vocabulary names the rules and declarations of trace and explanation in a
                                        vocabulary of the model (canonical: the canonical names)
  serve <descriptor.service.json> <source.rgs...> | <document.json> [--allow-markers] [--detail] [--host H] [--port N]
                                        the decision service on the JDK HttpServer (PLAYGROUND=true: the workbench;
                                        --detail or DETAIL=true: ?trace, ?coverage and ?fixpoint, and the
                                        workbench's ?via=service)
  drl <source.rgs...>                   the DRL text of uchar's DRL-text branch
  graph [--mmd] <out> <source.rgs...>   the rule graph as an HTML page, or with --mmd as Mermaid text
  facts <outdir> <source.rgs...>        the fact beans uchar's generator writes for the model

Several sources are read as one model, concatenated in the order given; paths are relative to the directory the
command is given in. Exit codes: 0 done, 1 an error in the model or a failed scenario, 2 a wrong invocation, 3 the
model resolves but uchar does not carry it (a marker).
TEXT
}

fail() { echo "regelspraak: $*" >&2; echo "(bin/regelspraak help geeft het gebruik)" >&2; exit 2; }

# the checkout this script belongs to, also when it is called through a symbolic link
self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case "$target" in /*) self=$target ;; *) self=$(dirname "$self")/$target ;; esac
done
ROOT=$(cd "$(dirname "$self")/.." && pwd -P)

# What the jar is built from: the reactor poms, the own main sources, and uchar's frontend and backend.
JAR_SOURCES=(pom.xml uchar-frontend/pom.xml toolchain/pom.xml toolchain/src/main service/pom.xml service/src/main
  uchar/frontends/regelspraak/grammar uchar/frontends/regelspraak/src/main uchar/backends/drools/pom.xml
  uchar/backends/drools/src/main)

jar_ready() {
  if [ -n "${REGELSPRAAK_JAR:-}" ]; then
    [ -f "$REGELSPRAAK_JAR" ] || { echo "regelspraak: REGELSPRAAK_JAR noemt geen bestand: $REGELSPRAAK_JAR" >&2; exit 1; }
    JAR=$REGELSPRAAK_JAR
    return
  fi
  JAR=$ROOT/service/target/regelspraak.jar
  [ -f "$ROOT/uchar/backends/drools/pom.xml" ] || {
    echo "regelspraak: de submodule uchar/ is niet uitgecheckt; draai in $ROOT: git submodule update --init --recursive" >&2
    exit 1
  }
  local newer=""
  if [ -f "$JAR" ]; then
    newer=$(cd "$ROOT" && find "${JAR_SOURCES[@]}" -newer "$JAR" -print -quit) \
      || { echo "regelspraak: de bronnen van de jar zijn niet te lezen in $ROOT" >&2; exit 1; }
    [ -z "$newer" ] && return
  fi
  command -v mvn >/dev/null 2>&1 || { echo "regelspraak: mvn ontbreekt, en de jar moet gebouwd worden" >&2; exit 1; }
  echo "regelspraak: de jar ${newer:+is ouder dan $newer en }wordt gebouwd (Maven offline, zonder tests)" >&2
  (cd "$ROOT" && mvn -B -q -o -DskipTests package -pl service -am) >&2 || {
    echo "regelspraak: de build faalt; de eerste build op een machine heeft één keer het netwerk nodig:" >&2
    echo "    (cd $ROOT && mvn -B -DskipTests package)" >&2
    exit 1
  }
}

# One JVM for the command; exec, so a signal to this script reaches the JVM and its exit code is the command's.
start() {
  local class_name=$1; shift
  jar_ready
  local java=java
  [ -n "${JAVA_HOME:-}" ] && java=$JAVA_HOME/bin/java
  # shellcheck disable=SC2086  # JAVA_OPTS carries several options on purpose
  exec "$java" ${language:+-Duchar.messages.locale=$language} ${JAVA_OPTS:-} -cp "$JAR" "$class_name" "$@"
}

# The sources of a command: at least one, each an existing file, and no option among them.
# an output file goes into a directory that exists: uchar would otherwise stop with a stack trace
check_out_dir() {
  local command=$1 out=$2 parent
  parent=$(dirname -- "$out")
  [ -d "$parent" ] || fail "$command: de map bestaat niet: $parent"
}

check_sources() {
  local command=$1; shift
  [ $# -gt 0 ] || fail "$command: geen bron.rgs opgegeven"
  local f
  for f in "$@"; do
    case "$f" in -*) fail "$command: onbekende optie $f" ;; esac
    [ -f "$f" ] || fail "$command: bestand niet gevonden: $f"
  done
}

CLI=dev.uchar.regelspraak.toolchain.cli.RegelSpraakCli
RESOLVER=dev.uchar.regelspraak.resolver.Resolver
SCENARIO=dev.uchar.regelspraak.toolchain.engine.ScenarioRunnerCli
SERVICE=dev.uchar.regelspraak.toolchain.service.http.ServiceMain

# Dutch is the language of the messages unless --language says en; the default itself is made in the Java code
# (MessageLanguage), so a start without this script reads the same.
language=
if [ "${1:-}" = --language ]; then
  case "${2:-}" in nl|en) language=$2; shift 2 ;; *) fail "--language verwacht nl of en" ;; esac
fi

[ $# -gt 0 ] || { usage >&2; exit 2; }
command=$1; shift
case "$command" in
  help|-h|--help)
    usage ;;
  check)
    check_sources check "$@"
    start "$CLI" "$@" ;;
  ir)
    [ $# -ge 1 ] || fail "ir: geen uit.json opgegeven"
    out=$1; shift
    case "$out" in -*) fail "ir: onbekende optie $out" ;; esac
    check_out_dir ir "$out"
    check_sources ir "$@"
    start "$RESOLVER" --ir "$out" "$@" ;;
  tokens)
    [ $# -ge 1 ] || fail "tokens: geen uit.json opgegeven"
    out=$1; shift
    case "$out" in -*) fail "tokens: onbekende optie $out" ;; esac
    check_out_dir tokens "$out"
    check_sources tokens "$@"
    start "$RESOLVER" --tokens "$out" "$@" ;;
  cases)
    [ $# -ge 1 ] || fail "cases: geen map opgegeven"
    dir=$1; shift
    case "$dir" in -*) fail "cases: onbekende optie $dir" ;; esac
    check_sources cases "$@"
    start "$RESOLVER" --ir "$dir/ir.json" --cases "$dir" "$@" ;;
  scenario)
    [ $# -gt 0 ] || fail "scenario: geen bron.rgs en geen --manifest opgegeven"
    start "$SCENARIO" "$@" ;;
  serve)
    [ $# -gt 0 ] || fail "serve: geen descriptor en geen bron opgegeven"
    start "$SERVICE" "$@" ;;
  drl)
    check_sources drl "$@"
    start "$CLI" --drl "$@" ;;
  graph)
    mode=--graph; rest=()
    for a in "$@"; do
      if [ "$a" = --mmd ]; then mode=--graph-mmd; else rest+=("$a"); fi
    done
    [ ${#rest[@]} -ge 1 ] || fail "graph: geen uitvoerbestand opgegeven"
    out=${rest[0]}
    case "$out" in -*) fail "graph: onbekende optie $out" ;; esac
    check_sources graph "${rest[@]:1}"
    start "$CLI" "$mode" "$out" "${rest[@]:1}" ;;
  facts)
    [ $# -ge 1 ] || fail "facts: geen uitmap opgegeven"
    outdir=$1; shift
    case "$outdir" in -*) fail "facts: onbekende optie $outdir" ;; esac
    check_sources facts "$@"
    start "$CLI" --facts "$outdir" "$@" ;;
  *)
    fail "onbekende opdracht: $command" ;;
esac
