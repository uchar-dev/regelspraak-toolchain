<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.uchar.regelspraak.toolchain</groupId>
  <artifactId>regelspraak-toolchain</artifactId>
  <version>0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>RegelSpraak toolchain (distribution on uchar)</name>
  <description>CLI, decision service and scenario runner for RegelSpraak, built from uchar (git submodule uchar/): uchar's RegelSpraak frontend and its Drools backend.</description>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <scm>
    <connection>scm:git:git@github.com:uchar-dev/regelspraak-toolchain.git</connection>
    <developerConnection>scm:git:git@github.com:uchar-dev/regelspraak-toolchain.git</developerConnection>
    <url>https://github.com/uchar-dev/regelspraak-toolchain</url>
  </scm>

  <!--
    The aggregator and parent of the distribution. This repository carries no parser, loader,
    transpiler or runtime of its own: it builds them from the uchar submodule.

      uchar/backends/drools  uchar's own pom, unchanged: its versions, its tests run with this build.
                             It is not a child of this parent, so the dependencyManagement below
                             does not reach it.
      uchar-frontend         uchar's RegelSpraak frontend (grammar, resolver, emitter) compiled from
                             the submodule's source tree.

    The versions below pin what the own modules link against. They must equal uchar's
    (scripts/check-pin.sh compares them): a different Jackson, ANTLR runtime or Drools would run
    uchar's code on versions uchar never tested it with.
  -->

  <modules>
    <module>uchar/backends/drools</module>
    <module>uchar-frontend</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- = ANTLR4_VERSION in uchar/frontends/regelspraak/Makefile -->
    <antlr.version>4.13.2</antlr.version>
    <!-- = drools.version, jackson.version and the junit-jupiter version in uchar/backends/drools/pom.xml -->
    <drools.version>8.44.0.Final</drools.version>
    <jackson.version>2.21.2</jackson.version>
    <junit.version>5.11.4</junit.version>
    <uchar.backend.version>0-SNAPSHOT</uchar.backend.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.uchar.backends</groupId>
        <artifactId>uchar-drools-backend</artifactId>
        <version>${uchar.backend.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.uchar.regelspraak.toolchain</groupId>
        <artifactId>uchar-frontend</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.antlr</groupId>
        <artifactId>antlr4-runtime</artifactId>
        <version>${antlr.version}</version>
      </dependency>
      <dependency>
        <groupId>org.drools</groupId>
        <artifactId>drools-engine</artifactId>
        <version>${drools.version}</version>
      </dependency>
      <dependency>
        <groupId>org.drools</groupId>
        <artifactId>drools-mvel</artifactId>
        <version>${drools.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.1</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.antlr</groupId>
          <artifactId>antlr4-maven-plugin</artifactId>
          <version>${antlr.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
