<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.yhavinga.regelspraak</groupId>
  <artifactId>regelspraak-engine</artifactId>
  <version>2.3.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>RegelSpraak v2.3.0 executable-model engine (consumer)</name>

  <!--
    The CONSUMER of the RegelSpraak -> Drools executable-model back-end: the shippable side of the split.

      * regelspraak-parser (the transpiler) is LEAN — it compiles against drools-canonical-model alone and only
        BUILDS an org.drools.model.Model (it never fires it). Build it first with `mvn -f ../pom.xml install`
        (or `make engine` from the repo root, which chains both).
      * THIS module adds the Drools RUNTIME (drools-engine) and FIRES the Model: RegelSpraakEngine.compile(src)
        resolves + transpiles + KieBaseBuilder.createKieBaseFromModel, then a Session inserts facts and fires.

    A Quarkus application wires the model in exactly this way — depend on regelspraak-parser + drools-engine,
    call RegelSpraakEngine, expose it behind a REST/CDI bean. (drools-quarkus-* would replace drools-engine for a
    native/Quarkus build; the RegelSpraakEngine facade is unchanged.)
  -->

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <drools.version>8.44.0.Final</drools.version>
    <junit.version>5.10.2</junit.version>
    <!-- Pinned to the SAME version as service/pom.xml (the version source of record for Jackson across the
         reactor); already in the local repo via the service module, so it resolves offline. -->
    <jackson.version>2.21.2</jackson.version>
    <!-- Declared so the skip-pin executions below can read ${skipTests}; zie de root-pom. -->
    <skipTests>false</skipTests>
  </properties>

  <dependencies>
    <!-- The transpiler front-end (parser + resolver + ExecModelTranspiler). Brings drools-canonical-model
         transitively (compile) — the Model-building DSL — but NOT the engine (its drools-core/engine/mvel are
         test-scoped, hence not transitive). -->
    <dependency>
      <groupId>io.github.yhavinga.regelspraak</groupId>
      <artifactId>regelspraak-parser</artifactId>
      <version>2.3.0-SNAPSHOT</version>
    </dependency>

    <!-- The Drools RUNTIME that COMPILES (KieBaseBuilder, drools-model-compiler) and FIRES (kiesession, core) the
         executable Model. The exec-model path is pure Java lambdas — it needs NO drools-mvel (that is the legacy
         DRL-string dialect). drools-engine brings drools-core (the accumulate-function impls accFn resolves at
         runtime) + drools-model-compiler + drools-kiesession transitively. -->
    <dependency>
      <groupId>org.drools</groupId>
      <artifactId>drools-engine</artifactId>
      <version>${drools.version}</version>
    </dependency>

    <!-- The DRL-string dialect + KieHelper (kie-internal) that the ScenarioRunner uses to build a KieBase with an
         EXPLICIT classloader (KieHelper.setClassLoader) over the FactModelGenerator beans compiled in-memory.
         The exec-model back-end (drools-engine above, the shippable path RegelSpraakEngine rides) cannot bind its
         LambdaMetafactory accessors against a FOREIGN (child) fact classloader — a parent Lookup cannot link a
         child loader's classes — so the runner takes the DOCUMENTED DRL fallback (docs/SCENARIOTOETSEN.md,
         § "Runner & CLI"), the proven TokaVuurTest pattern. DRL==exec parity is already differentially pinned.
         The root pom test-scopes drools-mvel, so it is declared here explicitly for the runner's main path. -->
    <dependency>
      <groupId>org.drools</groupId>
      <artifactId>drools-mvel</artifactId>
      <version>${drools.version}</version>
    </dependency>

    <!-- JSON voor de parameterset-sidecar (ParametersetLader). Zelfde Jackson/JSON-verhaal als de
         dienst-descriptor; de versie is hard gepind op service/pom.xml (de versiebron). -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <!-- skip-pin: zie de root-pom. Deze module heeft vandaag GEEN toegestane skip, dus elke skip of
           abort die hier opduikt faalt de poort bij naam in plaats van als "Skipped: 1" weg te vallen. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.1</version>
        <executions>
          <execution>
            <id>skip-pin-ijkpunt</id>
            <phase>process-test-classes</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${skipTests}</skip>
              <executable>bash</executable>
              <arguments>
                <argument>${basedir}/../tools/check-skips.sh</argument>
                <argument>--sentinel</argument>
                <argument>${project.build.directory}/.skip-pin-ijkpunt</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>skip-pin</id>
            <phase>test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${skipTests}</skip>
              <executable>bash</executable>
              <arguments>
                <argument>${basedir}/../tools/check-skips.sh</argument>
                <argument>engine</argument>
                <argument>${project.build.directory}/.skip-pin-ijkpunt</argument>
                <argument>${project.build.directory}/surefire-reports</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
