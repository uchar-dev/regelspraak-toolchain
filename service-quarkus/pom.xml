<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.yhavinga.regelspraak</groupId>
  <artifactId>regelspraak-service-quarkus</artifactId>
  <version>2.3.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>RegelSpraak v2.3.0 decision-service — Quarkus HTTP adapter (opt-in)</name>

  <!--
    ADDITIVE, OPT-IN Quarkus HTTP adapter over the framework-agnostic
    io.github.yhavinga.regelspraak.service.BeslisserKern (REUSED UNCHANGED). It gives the
    decision service Quarkus-native health/readiness probes, config injection and
    (host-side, deferred) a GraalVM native image — WITHOUT touching the RegelSpraak
    core. The zero-dependency JDK-HttpServer DienstHttp stays the DEFAULT delivery;
    this module is a STANDALONE build (no parent), NOT wired into the reactor.

    Deliberately NO parent POM so `mvn clean verify` at the repo root never pulls in
    the Quarkus dependency graph. Build it explicitly:
        mvn -f service-quarkus/pom.xml clean test
    Requires network on first run (Quarkus BOM/extensions download from Central); the
    regelspraak-* SNAPSHOTs must already be installed in ~/.m2.
  -->

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <quarkus.version>3.15.5</quarkus.version>
    <regelspraak.version>2.3.0-SNAPSHOT</regelspraak.version>
    <surefire.version>3.2.5</surefire.version>
    <rest-assured.version>5.5.0</rest-assured.version>
    <!-- keep the plugin/reactor from failing the build offline on plugin-metadata lookups -->
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <!-- Declared so the skip-pin executions below can read ${skipTests}; zie de root-pom. -->
    <skipTests>false</skipTests>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Quarkus 3.15.5 LTS (Java 21). Imported so every quarkus-* artifact below is version-aligned. -->
      <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- JAX-RS + Jackson (Quarkus REST, the "resteasy-reactive" successor). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <!-- SmallRye Health: serves /q/health/live and /q/health/ready automatically. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>
    <!-- ArC (CDI) for the @ApplicationScoped producer that builds the BeslisserKern singleton. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>

    <!-- The framework-agnostic decision-service core. Brings BeslisserKern + engine + drools + jackson
         transitively. REUSED UNCHANGED — this module owns no RegelSpraak meaning. -->
    <dependency>
      <groupId>io.github.yhavinga.regelspraak</groupId>
      <artifactId>regelspraak-service</artifactId>
      <version>${regelspraak.version}</version>
    </dependency>

    <!-- ===== test ===== -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <version>${rest-assured.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The service module's test-jar: the golden-parity harness (TokaBron, SituatieNaarVerzoek, the manifest
         reader). REUSED mechanically so no golden expected value is re-typed here. -->
    <dependency>
      <groupId>io.github.yhavinga.regelspraak</groupId>
      <artifactId>regelspraak-service</artifactId>
      <version>${regelspraak.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The Quarkus build (augmentation): wires CDI/JAX-RS/Health at build time. extensions=true registers
           the Quarkus lifecycle so @QuarkusTest boots the augmented app. -->
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <!-- @QuarkusTest boots ONE augmented app; a single fork is correct. Give it headroom for the 30
               DRL KieBase builds the TOKA service compiles at startup. -->
          <argLine>-Xmx1536m</argLine>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <!-- skip-pin: zie de root-pom. Deze module heeft vandaag GEEN toegestane skip, dus elke skip of
           abort die hier opduikt faalt de poort bij naam in plaats van als "Skipped: 1" weg te vallen. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.1</version>
        <executions>
          <execution>
            <id>skip-pin-ijkpunt</id>
            <phase>process-test-classes</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${skipTests}</skip>
              <executable>bash</executable>
              <arguments>
                <argument>${basedir}/../tools/check-skips.sh</argument>
                <argument>--sentinel</argument>
                <argument>${project.build.directory}/.skip-pin-ijkpunt</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>skip-pin</id>
            <phase>test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${skipTests}</skip>
              <executable>bash</executable>
              <arguments>
                <argument>${basedir}/../tools/check-skips.sh</argument>
                <argument>service-quarkus</argument>
                <argument>${project.build.directory}/.skip-pin-ijkpunt</argument>
                <argument>${project.build.directory}/surefire-reports</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- HOST-ONLY native build (deferred). Requires a GraalVM/Mandrel toolchain; NOT run in this sandbox.
         Build host-side with:  mvn -f service-quarkus/pom.xml -Pnative clean package  -->
    <profile>
      <id>native</id>
      <properties>
        <quarkus.package.type>native</quarkus.package.type>
      </properties>
    </profile>
  </profiles>
</project>
