<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.uchar.regelspraak.toolchain</groupId>
    <artifactId>regelspraak-toolchain</artifactId>
    <version>0-SNAPSHOT</version>
  </parent>

  <artifactId>service-quarkus</artifactId>
  <name>RegelSpraak decision service, Quarkus HTTP adapter</name>

  <!--
    A Quarkus HTTP adapter over the framework-agnostic service core (BeslisserKern, reused unchanged):
    health/readiness probes, config injection and, host-side, a native image. The JDK-HttpServer DienstHttp
    stays the default delivery.

    The Quarkus BOM is imported here only. Its Jackson (2.17 at Quarkus 3.15) would replace the Jackson uchar
    tests with, so the Jackson BOM of the parent's jackson.version is imported FIRST: of two imported BOMs the
    first one wins. The ANTLR runtime and Drools are pinned explicitly in the parent, and an explicit pin wins
    over any imported BOM. JUnit is left to the Quarkus BOM, whose quarkus-junit5 is built against it.
  -->

  <properties>
    <quarkus.version>3.15.5</quarkus.version>
    <rest-assured.version>5.5.0</rest-assured.version>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <skippin.poort>service-quarkus</skippin.poort>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- JAX-RS + Jackson (Quarkus REST). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <!-- SmallRye Health: /q/health/live and /q/health/ready. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>
    <!-- ArC (CDI) for the @ApplicationScoped producer that builds the BeslisserKern singleton. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.uchar.regelspraak.toolchain</groupId>
      <artifactId>service</artifactId>
    </dependency>

    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <version>${rest-assured.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The service module's test-jar: the golden-parity harness, reused so no expected value is re-typed. -->
    <dependency>
      <groupId>dev.uchar.regelspraak.toolchain</groupId>
      <artifactId>service</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The Quarkus build (augmentation); extensions=true registers the lifecycle @QuarkusTest boots. -->
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- @QuarkusTest boots one augmented app, so a single fork; headroom for the KieBases the TOKA
               service builds at startup. -->
          <argLine>-Xmx1536m</argLine>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Host-only native build; needs a GraalVM/Mandrel toolchain:
         mvn -pl service-quarkus -am -Pnative package -->
    <profile>
      <id>native</id>
      <properties>
        <quarkus.package.type>native</quarkus.package.type>
      </properties>
    </profile>
  </profiles>
</project>
